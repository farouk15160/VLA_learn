# virtualenv — 5 GB, never commit
.venv/
venv/
env/

# the SVHN dataset (62 MB) — supervised_learning.py downloads it on first run
data/*.mat
data/*.part

# the Udacity driving recordings (498 MB) — behavioral_cloning.py --fetch
# clones them from seraj94ai's repo. Never committed here: too large, and
# that repository carries no licence.
data/udacity_sim/

# demonstrations recorded in Gazebo (~28 MB) — regenerate with
#   ./behavioral_cloning/run_demo.sh collect
data/gazebo_track/

# the generated world: gazebo/make_track.py rebuilds it, and it is 320 KB of
# machine-written XML that would churn on every parameter change
behavioral_cloning/track.world
behavioral_cloning/centreline.csv

# python
__pycache__/
*.py[cod]
*.egg-info/

# generated
outputs/
*.png
*.pt
*.json
